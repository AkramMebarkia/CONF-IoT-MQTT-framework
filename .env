# .env file
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
NODE_RED_URL=http://localhost:1880

# Latency callback URL - where Node-RED sends latency batches
# Use http://localhost:5000 for same machine, http://your-ip:5000 for remote
LATENCY_CALLBACK_URL=http://host.docker.internal:5000/api/latency_batch

# For Docker internal communication
DOCKER_MQTT_HOST=nanomq
DOCKER_NODE_RED_URL=http://nodered:1880