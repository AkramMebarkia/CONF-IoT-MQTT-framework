# .env file - Single Remote Node-RED Configuration
# Remote Node-RED: 10.22.110.18
# Local Flask/Broker: 10.22.110.12

MQTT_BROKER_HOST=10.22.110.12
MQTT_BROKER_PORT=1883

# Single Node-RED instance on remote machine
NODE_RED_URL=http://10.22.110.18:1880

# Using single instance (leave empty or same as NODE_RED_URL)
NODE_RED_INSTANCES=http://10.22.110.18:1880

# Latency callback URL - remote Node-RED sends data to local Flask
LATENCY_CALLBACK_URL=http://10.22.110.12:5000/api/latency_batch

# For Docker internal communication (local Docker containers)
DOCKER_MQTT_HOST=mosquitto
DOCKER_NODE_RED_URL=http://nodered:1880